<!DOCTYPE html>
<html lang="{{ locale | languageTag }}" dir="{{ locale | textDirection }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ theme.colors.background }}">
    <title>{{ dgettext("marketing", title) }}</title>
    <meta name="description" content="{{ dgettext('marketing', description) }}">
    <link rel="canonical" href="https://habibi.fyi{{ page.url }}">
{% if not noindex %}
{% for alternate in locales %}
    <link rel="alternate" hreflang="{{ alternate | languageTag }}" href="https://habibi.fyi{{ alternate | homePath }}{{ alternatePath }}">
{% endfor %}
    <link rel="alternate" hreflang="x-default" href="https://habibi.fyi/{{ alternatePath }}">
{% endif %}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="habibi">
    <meta property="og:title" content="{{ dgettext('marketing', title) }}">
    <meta property="og:description" content="{{ dgettext('marketing', description) }}">
    <meta property="og:url" content="https://habibi.fyi{{ page.url }}">
    <meta property="og:image" content="https://habibi.fyi/assets/social.png">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ dgettext('marketing', 'Habibi. An agent of your own. An open-source personal agent in development.') }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ dgettext('marketing', title) }}">
    <meta name="twitter:description" content="{{ dgettext('marketing', description) }}">
    <meta name="twitter:image" content="https://habibi.fyi/assets/social.png">
    <meta name="twitter:image:alt" content="{{ dgettext('marketing', 'Habibi. An agent of your own. An open-source personal agent in development.') }}">
{% if noindex %}
    <meta name="robots" content="noindex">
{% endif %}
    <link rel="icon" href="/assets/heartling.svg" type="image/svg+xml">
    <link rel="preload" href="/assets/fonts/dm-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/assets/theme.css">
    <link rel="stylesheet" href="/assets/mascot/heartling.css">
    <link rel="stylesheet" href="/assets/styles.css">
{% if accessPage %}
    <link rel="stylesheet" href="/assets/access.css">
    <script src="/assets/access.js" defer></script>
{% endif %}
{% if changelogPage %}
    <link rel="stylesheet" href="/assets/changelog.css">
{% endif %}
  </head>
  <body>
    <a class="skip-link" href="#main">{{ dgettext("marketing", "Skip to content") }}</a>
    <header class="site-header wrap">
      <a class="wordmark" href="{{ locale | homePath }}" aria-label="{{ dgettext('marketing', 'habibi home') }}">{% include "companion.njk" %}<span>habibi</span></a>
      <nav aria-label="{{ dgettext('marketing', 'Main navigation') }}">
        <a href="{{ locale | homePath }}#privacy">{{ dgettext("marketing", "Privacy") }}</a>
        <a href="{{ locale | homePath }}changelog/"{% if changelogPage %} aria-current="page"{% endif %}>{{ dgettext("marketing", "Changelog") }}</a>
        <a href="{{ locale | homePath }}#access">{{ dgettext("marketing", "Request access") }} <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    {{ content | safe }}
    <footer class="site-footer wrap">
      <a class="wordmark" href="{{ locale | homePath }}" aria-label="{{ dgettext('marketing', 'habibi home') }}">{% include "companion.njk" %}<span>habibi</span></a>
      <p>{{ dgettext("marketing", "Open source. In development. No analytics.") }}</p>
      <nav aria-label="{{ dgettext('marketing', 'Footer navigation') }}">
        <a href="{{ locale | homePath }}#about">{{ dgettext("marketing", "About") }}</a>
        <a href="{{ locale | homePath }}changelog/"{% if changelogPage %} aria-current="page"{% endif %}>{{ dgettext("marketing", "Changelog") }}</a>
        <a href="https://github.com/pepicrft/habibi" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </footer>
  </body>
</html>
