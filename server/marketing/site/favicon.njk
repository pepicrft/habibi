---
permalink: /assets/heartling.svg
eleventyExcludeFromCollections: true
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 384">
  <style>
    @media (prefers-color-scheme: dark) {
      feFlood { flood-color: {{ theme.colors.accent }}; }
    }
  </style>
  <defs>
    <filter id="tint" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
      <feFlood flood-color="{{ theme.colors.primary }}" result="color" />
      <feBlend in="SourceGraphic" in2="color" mode="hard-light" />
      <feComposite in2="SourceAlpha" operator="in" />
    </filter>
  </defs>
  {# Favicon SVGs cannot load external images: embed the same neutral poster used on the page. #}
  <image width="384" height="384" href="data:image/png;base64,{{ heartlingPoster }}" filter="url(#tint)" />
</svg>
