  {
    "type": "function",
    "name": "present_component",
    "strict": true,
    "description": "Display a result_table v1 or a native kit_entry v1 card inside the conversation. Read the installed Kit definition before presenting its entry card; the host derives inputs from its actual fields. Optional prefill items are proposed values from this conversation, never saved entries. The user edits and explicitly saves locally; the model receives only displayed:true, not entered values. Never claim an entry was saved. No arbitrary UI, code, URLs or capabilities. Maximum32KiB; all string limits UTF-8 bytes. result_table:8 columns,20 rows,120 cells, exact row widths; show_source only reveals supplied data locally.",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component"
      ],
      "properties": {
        "component": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "version",
                "data",
                "actions",
                "fallback"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "result_table"
                  ]
                },
                "version": {
                  "type": "integer",
                  "enum": [
                    1
                  ]
                },
                "data": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "columns",
                    "rows"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "columns": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 8,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                      }
                    },
                    "rows": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 8,
                        "items": {
                          "type": "string",
                          "maxLength": 500
                        }
                      }
                    }
                  }
                },
                "actions": {
                  "type": "array",
                  "maxItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "label"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "enum": [
                          "show_source"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      }
                    }
                  }
                },
                "fallback": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "version",
                "data",
                "actions",
                "fallback"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "kit_entry"
                  ]
                },
                "version": {
                  "type": "integer",
                  "enum": [
                    1
                  ]
                },
                "data": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "kitId",
                    "prefill"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "kitId": {
                      "type": "string",
                      "description": "Exact installed Kit UUID returned by list_kits or save_kit."
                    },
                    "prefill": {
                      "type": "array",
                      "maxItems": 12,
                      "description": "Unique declared field keys only. Leave fields absent for the user to enter.",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "key",
                          "value"
                        ],
                        "properties": {
                          "key": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]{0,31}$"
                          },
                          "value": {
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 500
                              },
                              {
                                "type": "number",
                                "minimum": -1000000000,
                                "maximum": 1000000000
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                },
                "actions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "label"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "enum": [
                          "save_entry"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      }
                    }
                  }
                },
                "fallback": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              }
            }
          ]
        }
      }
    }
  }
]
