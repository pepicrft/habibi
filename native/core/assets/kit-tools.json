  {
    "type": "function",
    "name": "remove_kit",
    "description": "Remove a Kit AND its saved entries only after explicit host approval. Older backups are unaffected.",
    "strict": true,
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
